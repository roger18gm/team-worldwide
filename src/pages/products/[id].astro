---
import Layout from "../../layouts/Layout.astro";
import { type CollectionEntry, getCollection } from "astro:content";
import NotFound from "../../components/NotFound.svelte";
import WishlistButton from "../../components/WishlistButton.svelte";

// map though all products to create a page for each one
export async function getStaticPaths() {
  const products = await getCollection("products");

  return products.map((product) => ({
    params: { id: product.id },
    props: product,
  }));
}
type Props = CollectionEntry<"products">;

// get the product data from the props to use in the template below. The actual data is in product.data
const product = Astro.props;

// check if the product exists to handle the error case
const hasError = !product || !product.data;

// if there is an error, set the title to "Product Not Found", otherwise use the product's name
const title = hasError ? "Product Not Found" : product.data.name;

// check if the product has a discount and calculate the discount percentage if it does
const hasDiscount = !hasError && product.data.suggestedRetailPrice > product.data.finalPrice;
const discountPercent = hasDiscount 
  ? Math.round((1 - (product.data.finalPrice / product.data.suggestedRetailPrice)) * 100) 
  : 0;

const extraImages = product.data.images.extraImages ?? [];
const hasExtraImages = extraImages.length > 0;
---

<Layout title={title}>
  <script src="../../js/product.ts"></script>
  {hasExtraImages && <script src="../../js/productCarousel.ts"></script>}
  <main class="divider">
    {hasError ? (
      <NotFound 
        client:load 
        title="Product Not Found" 
        message="Sorry, we couldn't find the product you're looking for." 
      />
    ) : (
      <section class="product-detail">
        <h3>{product.data.brand.name}</h3>

        <h2 class="divider">{product.data.nameWithoutBrand}</h2>

        {hasExtraImages ? (
          <div class="product-gallery" data-product-gallery>  
            <div class="product-gallery__main">
              <button
                class="product-gallery__arrow product-gallery__arrow--previous"
                type="button"
                aria-label="Show previous product image"
                data-gallery-previous
              >
                &#8249;
              </button>
              <img
                class="product-gallery__image"
                src={product.data.images.primaryLarge}
                alt={product.data.name}
                data-gallery-image
              />
              <button
                class="product-gallery__arrow product-gallery__arrow--next"
                type="button"
                aria-label="Show next product image"
                data-gallery-next
              >
                &#8250;
              </button>
            </div>

            <div class="product-gallery__options" role="list" aria-label="Product images">
              <button
                class="product-gallery__option product-gallery__option--active"
                type="button"
                role="listitem"
                aria-label={`View ${product.data.name} main image`}
                aria-current="true"
                data-gallery-option
                data-image-src={product.data.images.primaryLarge}
                data-image-alt={product.data.name}
              >
                <img src={product.data.images.primaryLarge} alt="" aria-hidden="true" />
              </button>
              {extraImages.map((image, index: number) => (
                <button
                  class="product-gallery__option"
                  type="button"
                  role="listitem"
                  aria-label={`View ${image.title || `product image ${index + 2}`}`}
                  data-gallery-option
                  data-image-src={image.src}
                  data-image-alt={image.title || product.data.name}
                >
                  <img src={image.src} alt="" aria-hidden="true" />
                </button>
              ))}
            </div>
          </div>
        ) : (
          <img
            class="divider"
            src={product.data.images.primaryLarge}
            alt={product.data.name}
          />
        )}

        <div class="price-container">
          {hasDiscount && (
            <span class="badge-discount">Save {discountPercent}%</span>
            <span class="original-price"><s>${product.data.suggestedRetailPrice}</s></span>
          )}
          <span class="final-price">${product.data.finalPrice}</span>
        </div>

        <p class="product__color">{product.data.colors[0].colorName}</p>

        <p
          class="product__description"
          set:html={product.data.descriptionHtmlSimple}
        />

        <div class="product-detail__add">
          <button id="addToCart" data-id={product.data.id}>
            Add to Cart
          </button>
          <WishlistButton productId={product.data.id} client:load />
        </div>
      </section>
    )}
  </main>
</Layout>

<style>
  .price-container {
    display: flex;
    align-items: center;
    gap: 10px; 
    margin: 15px 0;
  }
  .badge-discount {
    background-color: #e63946; 
    color: white;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 0.9rem;
    font-weight: bold;
  }
  .original-price {
    color: #888;
    font-size: 1rem;
    text-decoration: line-through; 
  }
  .final-price {
    font-size: 1.4rem;
    font-weight: bold;
    color: #2a9d8f; 
  }

  .product-gallery {
    margin-bottom: 1rem;
  }

  .product-gallery__main {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-gallery__image {
    display: block;
    width: 100%;
  }

  .product-gallery__arrow {
    position: absolute;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1;
    border: 0;
    border-radius: 50%;
    width: 2rem;
    height: 2rem;
    background: rgb(0 0 0 / 65%);
    color: white;
    cursor: pointer;
    font-size: 1.75rem;
    line-height: 1;
    padding: 0;
  }

  .product-gallery__arrow:hover,
  .product-gallery__arrow:focus-visible {
    background: rgb(0 0 0 / 85%);
  }

  .product-gallery__arrow--previous {
    left: 0.75rem;
  }

  .product-gallery__arrow--next {
    right: 0.75rem;
  }

  .product-gallery__options {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.75rem;
    overflow-x: auto;
    padding: 0.15rem;
  }

  .product-gallery__option {
    flex: 0 0 4.5rem;
    border: 2px solid transparent;
    padding: 0;
    background: none;
    cursor: pointer;
  }

  .product-gallery__option--active,
  .product-gallery__option:focus-visible {
    border-color: var(--tertiary-color);
  }

  .product-gallery__option img {
    display: block;
    aspect-ratio: 1;
    width: 100%;
    object-fit: cover;
  }
</style>
