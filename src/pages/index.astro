---
import Welcome from "../components/Welcome.astro";
import Layout from "../layouts/Layout.astro";
import "../css/style.css";

const title = "Home";
---

<Layout title={title}>
  <main class="divider">
    <div class="hero">
      <img
        src="/images/banner-sm.jpg"
        srcset="images/banner-sm.jpg 500w, images/banner.jpg"
        alt="image of a high mountain lake"
      />
      <div class="logo logo--square">
        <img src="/images/noun_Tent_2517.svg" alt="tent image for logo" />
        <div>
          Sleep<span class="highlight">Outside</span>
        </div>
      </div>
    </div>
    
    <section class="mission">
      <p>We spend too much time these days indoors...sitting usually.</p>
      <p>No wonder we are a mess!</p>
      <p>
        What we really need is to get outside...in fact SLEEP outside. Our
        mission is to provide you with everything you need to do this
        comfortably at an affordable price.
      </p>
    </section>

    <!-- Categories Grid -->
    <section class="categories-grid">
      <a href="/product-list/?category=tents" class="category-card">
        <img src="/images/icons/noun_Tent_3544767.svg" alt="Tent Icon from Noun Project: Mustofa Bayu" />
        <h3>Tents</h3>
      </a>
      <a href="/product-list/?category=sleeping-bags" class="category-card">
        <img src="/images/icons/noun_Sleeping_Bag_3544775.svg" alt="Sleeping Bag Icon from Noun Project: Mustofa Bayu" />
        <h3>Sleeping Bags</h3>
      </a>
      <a href="/product-list/?category=backpacks" class="category-card">
        <img src="/images/icons/noun_carrier_bag_3544771.svg" alt="Backpack Icon from Noun Project: Mustofa Bayu" />
        <h3>Backpacks</h3>
      </a>
      <a href="/product-list/?category=hammocks" class="category-card">
        <img src="/images/icons/noun_Hammock_791143.svg" alt="Hammock Icon from Noun Project: Paul Richard" />
        <h3>Hammocks</h3>
      </a>
    </section>
  </main>
  <script src="../js/main.ts"></script>
</Layout>

<style>
  /* CSS to style the category grid */
  .categories-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    max-width: 900px;
    margin: 3rem auto;
    text-align: center;
  }

  .category-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: #333;
  }

  .category-card img {
    width: 80px;
    height: 80px;
    margin-bottom: 1rem;
    object-fit: contain;
    transition: transform 0.2s ease;
  }

  .category-card:hover img {
    transform: scale(1.1);
  }

  .category-card h3 {
    font-size: 1.1rem;
    font-weight: bold;
    margin: 0;
  }

  @media (max-width: 768px) {
    .categories-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>